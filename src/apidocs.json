{
  "openapi": "3.0.0",
  "info": {
    "title": "Quiz Backend API",
    "version": "1.0.0",
    "description": "API for quiz generation, cache, progress, history, tutorial utilities, and user preferences"
  },
  "servers": [
    {
      "url": "https://backend-dc-02.vercel.app/api",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Users", "description": "User preferences" },
    { "name": "Quiz", "description": "Quiz generation" },
    { "name": "Tutorial", "description": "Tutorial utilities" },
    { "name": "Progress", "description": "Quiz progress handling" },
    { "name": "Cache", "description": "Quiz cache handling" },
    { "name": "History", "description": "Quiz history management" }
  ],

  "paths": {
    "/users/{id}/preferences": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user preferences",
        "description": "Retrieve UI and theme preferences for a specific user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User preferences retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "User preferences retrieved successfully."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "preference": {
                          "type": "object",
                          "properties": {
                            "layoutWidth": {
                              "type": "string",
                              "example": "fullWidth"
                            },
                            "fontStyle": {
                              "type": "string",
                              "example": "serif"
                            },
                            "theme": {
                              "type": "string",
                              "example": "light"
                            },
                            "fontSize": {
                              "type": "string",
                              "example": "large"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/quiz/generate": {
      "post": {
        "tags": ["Quiz"],
        "summary": "Generate quiz from tutorial content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tutorialId", "level"],
                "properties": {
                  "tutorialId": { "type": "string", "example": "tutorial_1" },
                  "level": {
                    "type": "integer",
                    "enum": [1, 2, 3],
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quiz generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateQuizResponse"
                }
              }
            }
          }
        }
      }
    },

    "/tutorial/heading": {
      "get": {
        "tags": ["Tutorial"],
        "summary": "Get tutorial heading",
        "parameters": [
          {
            "name": "tutorialId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "tutorial_1" }
          }
        ],
        "responses": {
          "200": {
            "description": "Heading retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "heading": { "type": "string", "example": "Intro to JS" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/quiz/progress": {
      "post": {
        "tags": ["Progress"],
        "summary": "Save quiz progress",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveProgressRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/BasicSuccess" }
        }
      },
      "get": {
        "tags": ["Progress"],
        "summary": "Get quiz progress",
        "parameters": [
          { "$ref": "#/components/parameters/TutorialId" },
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/Level" }
        ],
        "responses": {
          "200": {
            "description": "Progress retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "progress": { "type": "object", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/quiz/cache": {
      "get": {
        "tags": ["Cache"],
        "summary": "Get quiz cache",
        "parameters": [
          { "$ref": "#/components/parameters/TutorialId" },
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/Level" }
        ],
        "responses": {
          "200": {
            "description": "Quiz cache retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "quizCache": { "type": "array", "nullable": true }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Cache"],
        "summary": "Save quiz cache",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveQuizCacheRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/BasicSuccess" }
        }
      }
    },

    "/quiz/clear": {
      "delete": {
        "tags": ["Cache"],
        "summary": "Clear quiz cache and/or progress",
        "parameters": [
          { "$ref": "#/components/parameters/TutorialId" },
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/Level" },
          {
            "name": "cache",
            "in": "query",
            "schema": { "type": "boolean", "default": true }
          },
          {
            "name": "progress",
            "in": "query",
            "schema": { "type": "boolean", "default": true }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "deleted": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/quiz/history": {
      "get": {
        "tags": ["History"],
        "summary": "Get quiz history",
        "responses": {
          "200": {
            "description": "History retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "history": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/QuizHistory"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "history": [
                    {
                      "id": 1768495214883,
                      "tutorialId": 35363,
                      "userId": 3,
                      "level": 1,
                      "quizData": [
                        {
                          "question": "Pilih kemampuan-kemampuan utama dari Smart Speaker yang dijelaskan dalam teks!",
                          "explanation": "",
                          "type": "multiple_answer",
                          "options": [
                            {
                              "key": "A",
                              "text": "Dapat membuka aplikasi sesuai perintah verbal.",
                              "isCorrect": true,
                              "feedback": "Betul, Smart Speaker bisa membuka aplikasi."
                            }
                          ],
                          "correctAnswers": ["A", "C", "D"],
                          "difficulty": "easy"
                        }
                      ],
                      "userAnswers": [["A", "B", "E"]],
                      "score": 11,
                      "totalQuestions": 3,
                      "percentage": 367,
                      "timestamp": "2026-01-15T16:40:14.883Z",
                      "createdAt": "2026-01-15T16:40:16.448Z"
                    }
                  ]
                }
              }
            }
          }
        }
      },

      "post": {
        "tags": ["History"],
        "summary": "Save quiz history",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizHistory"
              },
              "example": {
                "id": 1768495214883,
                "tutorialId": 35363,
                "userId": 3,
                "level": 1,
                "quizData": [
                  {
                    "question": "Pilih kemampuan-kemampuan utama dari Smart Speaker yang dijelaskan dalam teks!",
                    "explanation": "",
                    "type": "multiple_answer",
                    "options": [
                      {
                        "key": "A",
                        "text": "Dapat membuka aplikasi sesuai perintah verbal.",
                        "isCorrect": true,
                        "feedback": "Betul, Smart Speaker bisa membuka aplikasi."
                      }
                    ],
                    "correctAnswers": ["A", "C", "D"],
                    "difficulty": "easy"
                  }
                ],
                "userAnswers": [["A", "B", "E"]],
                "score": 11,
                "totalQuestions": 3,
                "percentage": 367,
                "timestamp": "2026-01-15T16:40:14.883Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "History saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "entry": {
                      "$ref": "#/components/schemas/QuizHistory"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "History saved",
                  "entry": {
                    "id": 1768495214883,
                    "tutorialId": 35363,
                    "userId": 3
                  }
                }
              }
            }
          }
        }
      },

      "delete": {
        "tags": ["History"],
        "summary": "Clear quiz history",
        "responses": {
          "200": {
            "description": "All history cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                },
                "example": {
                  "success": true,
                  "message": "All history cleared"
                }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "parameters": {
      "QuizHistory": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "tutorialId": { "type": "number" },
          "userId": { "type": "number" },
          "level": { "type": "number" },
          "quizData": { "type": "array", "items": { "type": "object" } },
          "userAnswers": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "score": { "type": "number" },
          "totalQuestions": { "type": "number" },
          "percentage": { "type": "number" },
          "timestamp": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },

    "responses": {
      "BasicSuccess": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
